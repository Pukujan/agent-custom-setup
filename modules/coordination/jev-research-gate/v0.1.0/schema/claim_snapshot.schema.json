{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim snapshot for research gate",
  "type": "object",
  "required": [
    "id",
    "claim_text"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "issue_ref": {
      "type": "string"
    },
    "claim_text": {
      "type": "string"
    },
    "known_docs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gold_decision": {
      "enum": [
        "yes",
        "no",
        "insufficient"
      ]
    }
  }
}
