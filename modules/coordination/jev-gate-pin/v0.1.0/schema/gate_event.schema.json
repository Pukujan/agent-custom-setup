{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pukujan/agent-custom-setup/modules/coordination/jev-gate-pin/v0.1.0/schema/gate_event.schema.json",
  "title": "JEV gate event (compact, no secrets)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ts",
    "decision",
    "tool_name",
    "reason_code"
  ],
  "properties": {
    "ts": {
      "type": "string",
      "description": "ISO-8601 timestamp"
    },
    "decision": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "escalate"
      ]
    },
    "tool_name": {
      "type": "string",
      "description": "Proposed tool name (no args secrets)"
    },
    "reason_code": {
      "type": "string",
      "description": "Short machine reason code"
    },
    "fixture_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional fixture id when scoring"
    },
    "judge": {
      "type": "string",
      "description": "Judge backend id (mock|inferhub|...)"
    },
    "notes": {
      "type": "string",
      "description": "Optional short note; must not contain secrets"
    }
  }
}
