{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pukujan/agent-custom-setup/modules/coordination/jev-gate-pin/v0.1.0/schema/gather_package.schema.json",
  "title": "Gatherer tiny package (pinned brief + proposed tool)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pinned_brief",
    "corrections",
    "proposed_tool"
  ],
  "properties": {
    "pinned_brief": {
      "type": "string",
      "description": "Capped pinned constraint brief (reinjected pins)"
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Short correction pins"
    },
    "proposed_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "args_summary"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "args_summary": {
          "type": "string",
          "description": "Non-secret summary of args (paths/URLs redacted as needed)"
        }
      }
    },
    "char_cap": {
      "type": "integer",
      "description": "Enforced package character cap (default 8000); ~2-8k class, never full-repo dump"
    },
    "token_cap_note": {
      "type": "string",
      "description": "Informational note on approximate token budget"
    },
    "fixture_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
