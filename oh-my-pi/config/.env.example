# ~/.omp/agent/.env — REAL SECRET VALUES, NEVER COMMIT THIS FILE.
# models.yml references these variable NAMES; OMP resolves them here.
inferhub_key=<inferhub api key>
ckff_astra=<ckff astra api key>
ckff_image=<ckff image api key>
ckff_url=<ckff base url>
base_URL=<optional base url>
openrouter_key=<openrouter api key — used by judge + jev-court>
