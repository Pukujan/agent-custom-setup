{
  "schema_version": "content-generation.visual-style.v1",
  "reference_asset": "assets/registry-icon.svg",
  "generation_workflow": "built-in image_gen",
  "narrative_roles": [
    "hero",
    "problem",
    "supporting",
    "evidence",
    "story",
    "social"
  ],
  "palette": {
    "background": "#0B1734",
    "primary": "#1C4EA3",
    "accent": "#50D6FF",
    "warm_accent": "#F7B955",
    "text": "#DCE9FF"
  },
  "subjects": [
    "operator workstation",
    "modular registry cards",
    "sanitized launcher"
  ],
  "composition": [
    "one dominant idea per asset",
    "keep registry structure readable",
    "support the story rather than replacing README text"
  ],
  "text_policy": "narrative raster assets carry one short title plus one short subtitle; icons, SVGs, logos, and tiny helper graphics remain text-free",
  "roles": {
    "hero": {
      "orientation": "wide",
      "dimensions": "1672x941"
    },
    "problem": {
      "orientation": "wide",
      "dimensions": "1672x941"
    },
    "system": {
      "orientation": "square",
      "dimensions": "1254x1254"
    },
    "evidence": {
      "orientation": "portrait",
      "dimensions": "1024x1536"
    },
    "icon": {
      "orientation": "svg",
      "dimensions": "64x64 viewBox",
      "path": "assets/registry-icon.svg"
    }
  },
  "reject_when": [
    "asset implies secrets are stored in git",
    "title or subtitle is unreadable",
    "image pretends narrative rasters exist when only the SVG icon is shipped"
  ]
}
