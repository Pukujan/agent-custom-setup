{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pukujan/agent-custom-setup/schemas/registry.schema.json",
  "title": "Agent custom-setup registry",
  "type": "object",
  "required": [
    "system",
    "version",
    "recorded_at",
    "modules"
  ],
  "properties": {
    "system": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_time": {
      "type": "object",
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ]
        },
        "end": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },
    "description": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/moduleIndexEntry"
      }
    }
  },
  "$defs": {
    "moduleIndexEntry": {
      "type": "object",
      "required": [
        "id",
        "version",
        "path",
        "recorded_at",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "recorded_at": {
          "type": "string"
        },
        "valid_time": {
          "type": "object"
        },
        "source_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "deprecated",
            "unknown"
          ]
        },
        "summary": {
          "type": "string"
        }
      }
    }
  }
}
