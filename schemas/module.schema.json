{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pukujan/agent-custom-setup/schemas/module.schema.json",
  "title": "Agent custom-setup module metadata",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "purpose",
    "harness",
    "created",
    "updated",
    "owning_issue",
    "owning_agent",
    "deploy_mirrors",
    "version",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable setup-id (folder name under modules/<harness>/)."
    },
    "name": {
      "type": "string",
      "description": "Human-readable setup name."
    },
    "purpose": {
      "type": "string",
      "description": "One-line purpose of this setup."
    },
    "harness": {
      "type": "string",
      "description": "Runtime harness id (e.g. coordination)."
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver; must match modules/<harness>/<setup-id>/v<semver>/."
    },
    "created": {
      "type": "string",
      "description": "ISO date or date-time when first recorded."
    },
    "updated": {
      "type": "string",
      "description": "ISO date or date-time of last accepted content change."
    },
    "owning_issue": {
      "type": "string",
      "description": "GitHub issue URL or #N owning this setup."
    },
    "owning_agent": {
      "type": "string",
      "description": "Primary writer / agent note."
    },
    "deploy_mirrors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "path"],
        "properties": {
          "label": { "type": "string" },
          "path": { "type": "string" },
          "notes": { "type": "string" }
        }
      },
      "description": "Deploy targets; ACS remains SoT — sync ACS → mirrors after merge."
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_time": {
      "type": "object",
      "properties": {
        "start": { "type": ["string", "null"] },
        "end": { "type": ["string", "null"] }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated", "unknown"]
    },
    "path": {
      "type": "string",
      "description": "Repo-relative module directory."
    },
    "source_paths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Historical import paths; not SoT after ACS adoption."
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": { "type": "string" },
          "role": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "secrets_policy": {
      "type": "object",
      "description": "Where secrets live at runtime; never commit values."
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "summary": {
      "type": "string"
    }
  }
}
