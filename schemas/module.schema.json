{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pukujan/agent-custom-setup/schemas/module.schema.json",
  "title": "Agent custom-setup module metadata",
  "type": "object",
  "required": [
    "id",
    "version",
    "recorded_at",
    "status",
    "files",
    "secrets_policy"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "recorded_at": {
      "type": "string"
    },
    "valid_time": {
      "type": "object"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "unknown"
      ]
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "secrets_policy": {
      "type": "object"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    }
  }
}
